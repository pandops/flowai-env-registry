{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/env-registry/error.reply.schema.json",
  "title": "env-registry error reply body (every ui operation and the open edge)",
  "description": "Reply header status is the HTTP-equivalent error status. Never carries a value, secret, key or token. request_id is absent only when the request carried no valid request_id header.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "enum": [
        "invalid_request",
        "not_found",
        "environment_unknown_or_unavailable",
        "scope_conflict",
        "invalid_cursor",
        "invalid_limit",
        "service_unavailable",
        "broker_unavailable",
        "claim_not_current",
        "configuration_error",
        "internal_error"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 200
    },
    "request_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "failure_reason": {
      "enum": ["missing_required_parameter"]
    },
    "missing_parameter": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    }
  }
}
