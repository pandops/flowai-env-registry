{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/env-registry/ui.list.request.schema.json",
  "title": "env-registry.ui.list.pub request",
  "description": "Core NATS request from API Gateway (rule 9). Headers team (decimal, never admin), operator_id, request_id, optional team_name. Body {params, body}; identifiers are JSON numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["params"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id"],
      "properties": {
        "team_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "scope": {
          "enum": ["team", "flow"]
        },
        "flow_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "limit": {
          "enum": [10, 25, 50, 100]
        }
      }
    }
  }
}
