{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/env-registry/ui.replace.request.schema.json",
  "title": "env-registry.ui.replace.pub request",
  "description": "Core NATS request from API Gateway (rule 9). Headers team (decimal, never admin), operator_id, request_id, optional team_name. Body {params, body}; identifiers are JSON numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["params", "body"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "environment_id"],
      "properties": {
        "team_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "environment_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "name", "env"],
      "properties": {
        "scope": {
          "enum": ["team", "flow"]
        },
        "flow_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          }
        }
      }
    }
  }
}
